<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/input_background"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Customer Name -->
    <TextView
        android:id="@+id/tv_customer_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="John Doe"
        android:textColor="@color/dark_purple"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Booking ID -->
    <TextView
        android:id="@+id/tv_booking_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="ID: booking_1234567890"
        android:textColor="@color/medium_purple"
        android:textSize="11sp"
        android:alpha="0.8" />

    <!-- Contact Information -->
    <TextView
        android:id="@+id/tv_contact_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="john.doe@email.com • +44 7123 456789"
        android:textColor="@color/medium_purple"
        android:textSize="12sp"
        android:textStyle="italic" />

    <!-- Class Name -->
    <TextView
        android:id="@+id/tv_class_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Flow Yoga"
        android:textColor="@color/medium_purple"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Booking Date and Time -->
    <TextView
        android:id="@+id/tv_booking_datetime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="2024-01-15 at 10:00 AM"
        android:textColor="@color/dark_gray"
        android:textSize="14sp" />

    <!-- Status and Payment Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CONFIRMED"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/status_background"
            android:padding="4dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_payment_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="£15.00 - PAID"
            android:textColor="@color/dark_gray"
            android:textSize="12sp"
            android:gravity="end" />

    </LinearLayout>

</LinearLayout>
