<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Date Field -->
    <TextView
        style="@style/LabelStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Date *" />

    <Button
        android:id="@+id/btn_select_date"
        style="@style/MenuButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Select Date"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tap to select a date from the calendar. Only dates matching this class's day of week will be available."
        android:textColor="@color/medium_purple"
        android:textSize="12sp"
        android:textStyle="italic" />

    <!-- Teacher Field -->
    <TextView
        style="@style/LabelStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Teacher *" />

    <EditText
        android:id="@+id/et_teacher"
        style="@style/InputFieldStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter teacher name"
        android:inputType="textPersonName" />

    <!-- Additional Comments Field -->
    <TextView
        style="@style/LabelStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Additional Comments (Optional)" />

    <EditText
        android:id="@+id/et_comments"
        style="@style/InputFieldStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:hint="Enter any additional comments"
        android:inputType="textMultiLine"
        android:lines="3" />

</LinearLayout>