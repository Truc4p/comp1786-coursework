<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_purple"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_class_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flow Yoga"
            android:textColor="@color/dark_purple"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_class_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Monday at 10:00 AM"
            android:textColor="@color/medium_purple"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Class Instances"
            android:textColor="@color/dark_purple"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tap an instance to edit or delete"
            android:textColor="@color/medium_purple"
            android:textSize="14sp"
            android:textStyle="italic" />

    </LinearLayout>

    <!-- Instances List -->
    <ListView
        android:id="@+id/listview_class_instances"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/medium_purple"
        android:dividerHeight="1dp"
        android:paddingBottom="8dp"
        android:paddingTop="8dp" />

    <!-- No Instances Message -->
    <LinearLayout
        android:id="@+id/tv_no_instances"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No class instances found"
            android:textColor="@color/medium_purple"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Start by adding your first class instance!"
            android:textColor="@color/medium_purple"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Add Instance Button -->
    <Button
        android:id="@+id/btn_add_instance"
        style="@style/ButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="+ Add Class Instance" />

    <!-- Back Button -->
    <Button
        android:id="@+id/btn_back"
        style="@style/ButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="← Back" />

</LinearLayout>