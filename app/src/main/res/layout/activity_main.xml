<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_purple"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        tools:context=".MainActivity">

        <!-- Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Universal Yoga"
                android:textColor="@color/dark_purple"
                android:textSize="36sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Admin Dashboard"
                android:textColor="@color/medium_purple"
                android:textSize="18sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/tv_welcome_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Welcome, Admin!"
                android:textColor="@color/medium_purple"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Main Menu Buttons Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Management Section -->
            <TextView
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="Class Management"
                android:textColor="@color/dark_purple"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_class_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:text="Total Classes: 0"
                android:textColor="@color/dark_purple"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_add_class"
                    style="@style/ButtonStyleSecondary1"
                    android:layout_width="280dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="12dp"
                    android:text="Add New Yoga Class"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_view_classes"
                    style="@style/ButtonStyleSecondary02"
                    android:layout_width="280dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="12dp"
                    android:text="View &amp; Manage Classes"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_search_classes"
                    style="@style/ButtonStyleSecondary3"
                    android:layout_width="280dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:text="Search Classes"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_view_bookings"
                    style="@style/ButtonStyleSecondary4"
                    android:layout_width="280dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="12dp"
                    android:text="View Customer Bookings"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_cloud_sync"
                    style="@style/ButtonStyleSecondary5"
                    android:layout_width="280dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="12dp"
                    android:text="Cloud Sync"
                    android:textSize="16sp" />

                <!-- Logout Button -->
                <Button
                    android:id="@+id/btn_logout"
                    style="@style/ButtonStyleSecondary6"
                    android:layout_width="280dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:text="Logout"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Footer Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="✨ Manage your yoga studio with ease"
                android:textColor="@color/medium_purple"
                android:textSize="16sp"
                android:textStyle="italic" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>