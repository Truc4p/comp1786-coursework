<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_purple"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yoga Classes"
            android:textColor="@color/dark_purple"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tap a class to view, edit, or delete"
            android:textColor="@color/medium_purple"
            android:textSize="14sp"
            android:textStyle="italic" />

    </LinearLayout>

    <!-- Quick Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_quick_search"
            style="@style/InputFieldStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Search by instructor name..."
            android:inputType="textPersonName" />

        <Button
            android:id="@+id/btn_advanced_search"
            style="@style/ButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Advanced" />

    </LinearLayout>

    <!-- Classes List -->
    <ListView
        android:id="@+id/listview_yoga_classes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/medium_purple"
        android:dividerHeight="1dp"
        android:paddingBottom="8dp"
        android:paddingTop="8dp" />

    <!-- No Classes Message -->
    <LinearLayout
        android:id="@+id/tv_no_classes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No yoga classes found"
            android:textColor="@color/medium_purple"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Start by adding your first yoga class!"
            android:textColor="@color/medium_purple"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Back Button -->
    <Button
        android:id="@+id/btn_back"
        style="@style/ButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="← Back to Main Menu" />

</LinearLayout> 