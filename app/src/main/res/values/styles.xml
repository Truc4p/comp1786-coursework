<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ButtonStyle">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">@color/dark_purple</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <style name="InputFieldStyle">
        <item name="android:background">@drawable/input_background</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/medium_purple</item>
        <item name="android:textColorHint">@color/light_purple_2</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="LabelStyle">
        <item name="android:textColor">@color/dark_purple</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="SpinnerStyle" parent="InputFieldStyle">
        <item name="android:textColor">@color/medium_purple</item>
        <item name="android:textSize">16sp</item>
    </style>
        
    <style name="ButtonStyleSecondary" parent="ButtonStyle">
        <item name="android:textColor">@color/dark_purple</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:backgroundTint">@color/accent_green</item>
    </style>
    
    <style name="ButtonStyleSecondary2" parent="ButtonStyle">
        <item name="android:textColor">@color/dark_purple</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:backgroundTint">@color/accent_yellow</item>
    </style>

    <style name="ButtonStyleOutline" parent="ButtonStyle">
        <item name="android:textColor">@color/dark_purple</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:backgroundTint">@color/accent_orange</item>
    </style>
</resources> 