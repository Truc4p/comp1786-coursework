# Firebase Configuration
# Replace with your Firebase Realtime Database URL
EXPO_PUBLIC_API_BASE_URL="your Firebase Realtime Database URL"

# App Configuration
EXPO_PUBLIC_APP_NAME=Yoga Studio
EXPO_PUBLIC_APP_VERSION=1.0.0

# Feature Flags (set to 'true' or 'false')
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
EXPO_PUBLIC_ENABLE_PAYMENT_INTEGRATION=false
EXPO_PUBLIC_ENABLE_SOCIAL_LOGIN=false
EXPO_PUBLIC_ENABLE_AUTHENTICATION=true
EXPO_PUBLIC_ENABLE_GUEST_MODE=true
